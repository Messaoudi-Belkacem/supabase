# OTT CRM — Production Caddyfile
#
# Three domains:
#
#   PROXY_DOMAIN  → React frontend      (ott-frontend container)
#   API_DOMAIN    → Supabase API        (Kong: auth, rest, storage, realtime, functions)
#   STUDIO_DOMAIN → Supabase Studio     (password-protected admin dashboard)
#
# All TLS certificates are issued automatically by Let's Encrypt.
# PROXY_AUTH_PASSWORD is pre-hashed by the entrypoint command in docker-compose.caddy.yml.

{$PROXY_DOMAIN} {
    reverse_proxy ott-frontend:80
    header -server
}

{$API_DOMAIN} {
    reverse_proxy kong:8000
    header -server
}

{$STUDIO_DOMAIN} {
    basic_auth {
        {$PROXY_AUTH_USERNAME} {$PROXY_AUTH_PASSWORD}
    }
    reverse_proxy studio:3000
    header -server
}
